# Образец файла с ключами. Скопируйте в .env и заполните своими значениями.
# Настоящий .env в git не попадает — он уже прописан в .gitignore.
# Правило простое: если строку нельзя показать постороннему, её место здесь,
# а не в коде.

# Google Cloud (появится на второй неделе)
BQ_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=/полный/путь/к/ключу.json

# Gemini (третья неделя)
GEMINI_API_KEY=

# Telegram-бот для дайджеста (четвёртая неделя)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Adzuna (второй источник)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
